  // ───────── Auth ─────────
  async 'POST auth/register'(c) {
    await rate(c, 'reg:' + c.ip, 5, 600);
    const b = c.body;
    const email = clean(b.email, 120).toLowerCase(), name = clean(b.name, 60);
    if (/circle\s*host|\(\s*ai\s*\)|🤖/i.test(name)) fail('Please use your real name. "Circle Host" and "(AI)" are reserved for the labeled AI hosts.');
    let mobile = clean(b.mobile, 20).replace(/[\s-]/g, '');
    if (!isEmail(email)) fail('Enter a valid email.');
    if (!/^(\+63|0)9\d{9}$/.test(mobile)) fail('Enter a valid PH mobile (09XXXXXXXXX).');
    if (mobile.startsWith('0')) mobile = '+63' + mobile.slice(1);
    if (name.length < 2) fail('Enter your name.');
    if (String(b.password || '').length < 10) fail('Password must be at least 10 characters.');
    if (!b.consent) fail('Please agree to the Privacy Notice (RA 10173).');
    if (!b.adult) fail('The Virtual Circle is for adults (18+).');
    if (!(await turnstileOk(c, b.turnstile))) fail('Verification failed. Try again.');
    const type = b.account_type === 'client' ? 'client' : 'va';
    const tier = type === 'va' ? (['newbie', 'seasoned'].includes(b.tier) ? b.tier : fail('Choose Newbie or Seasoned.')) : '';
    if (await c.db.first('SELECT 1 FROM users WHERE email = ? OR mobile = ?', email, mobile)) fail('That email or mobile is already registered.', 409);
    const ref = clean(b.ref, 12).toUpperCase();
    const referrer = ref ? await c.db.first("SELECT 1 FROM users WHERE referral_code = ? AND account_type <> 'host'", ref) : null;
    const fp = b.fingerprint ? await sha256(String(b.fingerprint)) : '';
    const u = { id: uid(), email, name, mobile, mobile_verified: 0, pw_hash: await hashPw(b.password), role: type, account_type: type, tier,
      status: 'pending_otp', region: clean(b.region, 20), hub: clean(b.hub, 40), badges: '[]', risk_points: 0, muted_until: 0,
      referral_code: randHex(3).toUpperCase(), referred_by: referrer ? ref : '', fingerprint: fp, consent_at: now(), created_at: now() };
    try { await c.db.insert('users', u); } catch (e) { if (/UNIQUE/.test(e.message)) fail('That email or mobile is already registered.', 409); throw e; }
    if (fp) {
      const dup = await c.db.first('SELECT COUNT(*) n FROM users WHERE fingerprint = ? AND id <> ?', fp, u.id);
      if (dup.n) await penalize(c, u, 'dup_fingerprint', `${dup.n} other account(s) share this device`, 'high');
    }
    await sendOtp(c, u);
    c.user = u; await audit(c, 'register', u.id, `${type} ${tier}`);
    return { ok: true, next: 'otp', _session: u.id };
  },
  async 'POST auth/login'(c) {
    await rate(c, 'login:' + c.ip, 10, 300);
    const u = await c.db.first('SELECT id, pw_hash, status FROM users WHERE email = ?', clean(c.body.email, 120).toLowerCase());
    // Verify even when the email is unknown so timing does not reveal registered emails
    const ok = await verifyPw(String(c.body.password || ''), u ? u.pw_hash : 'AAAAAAAAAAAAAAAAAAAAAA==$x');
    if (!u || !ok) fail('Wrong email or password.', 401);
