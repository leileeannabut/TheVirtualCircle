    const matches = await c.db.all(`SELECT m.*, u.name, u.va_rank, u.account_type, u.role FROM bff_matches m JOIN users u ON u.id = CASE WHEN m.a = ?1 THEN m.b ELSE m.a END
      WHERE (m.a = ?1 OR m.b = ?1) AND m.status = 'active' ORDER BY m.ts DESC`, u.id);
    const counts = await c.db.all("SELECT topic, mode, COUNT(*) n FROM struggles WHERE active = 1 GROUP BY topic, mode");
    return { topics: Object.entries(TOPICS).map(([id, t]) => ({ id, label: t.label, going: counts.find((x) => x.topic === id && x.mode === 'going_through')?.n || 0, been: counts.find((x) => x.topic === id && x.mode === 'been_through')?.n || 0 })),
      mine, matches: matches.map((m) => ({ id: m.id, topic: m.topic, label: TOPICS[m.topic]?.label || m.topic, kind: m.kind, role: m.a === u.id ? 'seeker' : 'helper', with: { id: m.a === u.id ? m.b : m.a, name: m.name, rank_name: rankName(c, m.va_rank, m.account_type, m.role) }, channel: dmId(m.a, m.b) })) };
  },
  async 'POST bff/set'(c) {
    const u = needActive(c);
    const topic = Object.prototype.hasOwnProperty.call(TOPICS, c.body.topic || '') ? c.body.topic : fail('Pick a topic.');
    const mode = c.body.mode === 'been_through' ? 'been_through' : 'going_through';
    if (c.body.on === false) { await c.db.run('UPDATE struggles SET active = 0 WHERE user_id = ? AND topic = ? AND mode = ?', u.id, topic, mode); return { ok: true }; }
    await c.db.run(`INSERT INTO struggles (id, user_id, topic, mode, note, ts, active) VALUES (?,?,?,?,?,?,1)
      ON CONFLICT(user_id, topic, mode) DO UPDATE SET active = 1, note = excluded.note, ts = excluded.ts`, uid(), u.id, topic, mode, clean(c.body.note, 300), now());
    const matched = await autoMatch(c, u, topic, mode);
    return { ok: true, matched };
  },
  async 'POST bff/end'(c) {
    const u = needActive(c);
    await c.db.run("UPDATE bff_matches SET status = 'ended' WHERE id = ? AND (a = ? OR b = ?)", c.body.id, u.id, u.id);
    return { ok: true };
  },

  // ───────── Learning ─────────
  async 'GET learn/courses'(c) {
    const u = needActive(c);
    const rows = await c.db.all(`SELECT co.*, (SELECT COUNT(*) FROM lessons l WHERE l.course_id = co.id) lessons,
      (SELECT COUNT(*) FROM lesson_progress p WHERE p.course_id = co.id AND p.user_id = ? AND p.passed = 1) passed,
      (SELECT 1 FROM certificates ce WHERE ce.course_id = co.id AND ce.user_id = ?) certified
      FROM courses co WHERE co.status = 'published' ORDER BY co.sort, co.created_at`, u.id, u.id);
    return { courses: rows.map((r) => ({ id: r.id, title: r.title, summary: r.summary, level: r.level, pro: !!r.pro, locked: !!r.pro && !isPro(u), lessons: r.lessons, passed: r.passed, certified: !!r.certified })), pro: isPro(u) };
  },
  async 'GET learn/course'(c) {
    const u = needActive(c);
    const co = await c.db.first('SELECT * FROM courses WHERE id = ?', clean(c.query.id, 60)) || fail('Course not found', 404);
    if (co.status !== 'published' && !canAuthor(c, u)) fail('Course not found', 404);
    const lessons = await c.db.all(`SELECT l.id, l.title, l.position, l.simulator, p.score, p.passed FROM lessons l LEFT JOIN lesson_progress p ON p.lesson_id = l.id AND p.user_id = ?
      WHERE l.course_id = ? ORDER BY l.position`, u.id, co.id);
    return { course: { id: co.id, title: co.title, summary: co.summary, level: co.level, pro: !!co.pro, locked: !!co.pro && !isPro(u) }, lessons: lessons.map((l) => ({ ...l, passed: !!l.passed })) };
  },
  async 'GET learn/lesson'(c) {
    const u = needActive(c);
    const l = await c.db.first('SELECT l.*, co.pro, co.status FROM lessons l JOIN courses co ON co.id = l.course_id WHERE l.id = ?', clean(c.query.id, 80)) || fail('Lesson not found', 404);
    if (l.status !== 'published' && !canAuthor(c, u)) fail('Lesson not found', 404);
    if (l.pro && !isPro(u) && !canAuthor(c, u)) fail('This training material is part of Tier 2 · Circle Pro. Upgrade on the Membership page to unlock it.', 402);
    return { lesson: { id: l.id, course_id: l.course_id, title: l.title, slides: pj(l.slides, []), simulator: l.simulator, pass_pct: l.pass_pct,
      quiz: pj(l.quiz, []).map(({ q, choices }) => ({ q, choices })) } };
  },
  async 'POST learn/submit'(c) {
    const u = needActive(c); await rate(c, 'quiz:' + u.id, 60, 3600);
    const l = await c.db.first('SELECT l.*, co.title AS course_title, co.pro FROM lessons l JOIN courses co ON co.id = l.course_id WHERE l.id = ?', clean(c.body.lesson_id, 80)) || fail('Lesson not found', 404);
    if (l.pro && !isPro(u) && !canAuthor(c, u)) fail('This training material is part of Tier 2 · Circle Pro.', 402);
    const quiz = pj(l.quiz, []); const answers = Array.isArray(c.body.answers) ? c.body.answers : [];
    const results = quiz.map((q, i) => ({ correct: Number(answers[i]) === q.answer, answer: q.answer, explain: q.explain }));
    const score = quiz.length ? Math.round(100 * results.filter((r) => r.correct).length / quiz.length) : 100;
    const passed = score >= l.pass_pct;
    const prev = await c.db.first('SELECT score, passed FROM lesson_progress WHERE user_id = ? AND lesson_id = ?', u.id, l.id);
    if (!prev || score > prev.score) await c.db.run('INSERT OR REPLACE INTO lesson_progress (user_id, lesson_id, course_id, score, passed, ts) VALUES (?,?,?,?,?,?)', u.id, l.id, l.course_id, score, passed || prev?.passed ? 1 : 0, now());
    let certificate = null;
    const pr = await courseProgress(c, u.id, l.course_id);
    if (pr.total && pr.passed === pr.total) {
      const r = await c.db.run('INSERT OR IGNORE INTO certificates (id, user_id, course_id, ts) VALUES (?,?,?,?)', uid(), u.id, l.course_id, now());
      if (r.meta.changes) {
        await addBadge(c, u.id, 'Certified: ' + l.course_title);
        await c.db.insert('notifications', { ts: now(), user_id: u.id, type: 'certificate', text: `🎓 You earned your certificate for "${l.course_title}"`, link: '/learn.html#course=' + l.course_id, read: 0 });
      }
      certificate = (await c.db.first('SELECT id FROM certificates WHERE user_id = ? AND course_id = ?', u.id, l.course_id)).id;
    }
    return { score, passed, pass_pct: l.pass_pct, results, certificate, progress: pr };
  },
  async 'POST learn/simulator'(c) {
    const u = needActive(c); await rate(c, 'simx:' + u.id, 60, 3600);
    const sim = ['inbox', 'calendar', 'dataentry'].includes(c.body.sim) ? c.body.sim : fail('Unknown simulator');
    const score = Math.max(0, Math.min(100, Math.round(Number(c.body.score) || 0)));
    await c.db.insert('simulations', { ts: now(), user_id: u.id, scenario: 'sim:' + sim, transcript: clean(c.body.detail, 2000), score_comm: null, score_tech: score, score_crisis: null, overall: score, feedback: '' });
    const avg = Math.round((await c.db.first('SELECT AVG(overall) a FROM simulations WHERE user_id = ?', u.id)).a);
    await c.db.update('users', u.id, { sim_score: avg });
    const badge = { inbox: 'Inbox Triage Pro', calendar: 'Time-Zone Wizard', dataentry: 'Data Accuracy Pro' }[sim];
    if (score >= 85) await addBadge(c, u.id, badge);
    return { score, average: avg, badge: score >= 85 ? badge : null };
  },
  async 'GET learn/certificate'(c) {
    need(c);
    const r = await c.db.first('SELECT ce.*, co.title, u.name FROM certificates ce JOIN courses co ON co.id = ce.course_id JOIN users u ON u.id = ce.user_id WHERE ce.id = ?', clean(c.query.id, 60)) || fail('Certificate not found', 404);
    return { certificate: { id: r.id, name: r.name, course: r.title, ts: r.ts } };
  },

  // ───────── CMS (Senior VA rank or staff) ─────────
  async 'GET cms/courses'(c) {
    const u = needActive(c); if (!canAuthor(c, u)) fail('Course authoring unlocks at Senior VA rank.', 403);
    const rows = await c.db.all(`SELECT co.*, (SELECT COUNT(*) FROM lessons l WHERE l.course_id = co.id) lessons FROM courses co
      WHERE ? OR co.author_id = ? ORDER BY co.sort, co.created_at`, STAFF.includes(u.role) ? 1 : 0, u.id);
    return { courses: rows.map((r) => ({ ...r, pro: !!r.pro })) };
  },
  async 'GET cms/lessons'(c) {
    const u = needActive(c); if (!canAuthor(c, u)) fail('Not allowed', 403);
    return { lessons: (await c.db.all('SELECT * FROM lessons WHERE course_id = ? ORDER BY position', clean(c.query.course_id, 60))).map((l) => ({ ...l, slides: pj(l.slides, []), quiz: pj(l.quiz, []) })) };
  },
  async 'POST cms/course'(c) {
    const u = needActive(c); if (!canAuthor(c, u)) fail('Not allowed', 403);
    const b = c.body; const title = clean(b.title, 140); if (title.length < 3) fail('Add a course title.');
    const row = { title, summary: clean(b.summary, 400), level: ['Beginner', 'Intermediate', 'Advanced'].includes(b.level) ? b.level : 'Beginner',
      pro: !!b.pro, status: b.status === 'published' && STAFF.includes(u.role) ? 'published' : b.status === 'published' ? 'review' : 'draft', sort: Number(b.sort) || 50 };
    if (b.id) {
      const co = await c.db.first('SELECT author_id FROM courses WHERE id = ?', b.id) || fail('Not found', 404);
      if (co.author_id !== u.id && !STAFF.includes(u.role)) fail('Not your course.', 403);
      await c.db.update('courses', b.id, row); return { id: b.id, status: row.status };
    }
    return { id: (await c.db.insert('courses', { ...row, author_id: u.id, created_at: now() })).id, status: row.status };
  },
  async 'POST cms/lesson'(c) {
    const u = needActive(c); if (!canAuthor(c, u)) fail('Not allowed', 403);
    const b = c.body;
    const co = await c.db.first('SELECT author_id FROM courses WHERE id = ?', b.course_id) || fail('Course not found', 404);
    if (co.author_id !== u.id && !STAFF.includes(u.role)) fail('Not your course.', 403);
    const row = { course_id: b.course_id, title: clean(b.title, 140) || 'Untitled lesson', position: Number(b.position) || 1, slides: cleanSlides(b.slides), quiz: cleanQuiz(b.quiz),
      pass_pct: Math.max(0, Math.min(100, Number(b.pass_pct) || 70)), simulator: ['inbox', 'calendar', 'dataentry'].includes(b.simulator) ? b.simulator : '' };
    if (b.id) { await c.db.update('lessons', b.id, row); return { id: b.id }; }
    return { id: (await c.db.insert('lessons', row)).id };
  },
  async 'POST cms/lesson/delete'(c) {
    const u = needActive(c); if (!canAuthor(c, u)) fail('Not allowed', 403);
    const l = await c.db.first('SELECT l.id, co.author_id FROM lessons l JOIN courses co ON co.id = l.course_id WHERE l.id = ?', c.body.id) || fail('Not found', 404);
    if (l.author_id !== u.id && !STAFF.includes(u.role)) fail('Not your course.', 403);
    await c.db.batch([c.db.stmt('DELETE FROM lessons WHERE id = ?', l.id), c.db.stmt('DELETE FROM lesson_progress WHERE lesson_id = ?', l.id)]);
    return { ok: true };
  },

  // ───────── Tier 2 · Circle Pro ─────────
  async 'GET pro/status'(c) {
    const u = need(c);
    return { pro: isPro(u), pro_until: u.pro_until || 0, price_php: cfgNum(c, 'pro_price_php'), free_ai_sims_per_day: cfgNum(c, 'free_ai_sims_per_day') };
  },
  async 'POST pro/subscribe'(c) {
    needActive(c);
    return checkout(c, { ref_type: 'pro', ref_id: c.user.id, amount: cfgNum(c, 'pro_price_php'), description: 'Tier 2 · Circle Pro membership (30 days)', back: '/pro.html?for=pro' });
  },

  // ───────── Direct job posts (clients pay, VAs apply free) ─────────
  async 'POST jobs/create'(c) {
    const u = needActive(c, ['client', 'recruiter', ...STAFF]);
    const b = c.body; const title = clean(b.title, 140); if (title.length < 4) fail('Add a job title.');
    const description = clean(b.description, 4000).replace(/\\n/g, '\n'); if (description.length < 40) fail('Describe the role (40+ characters).');
    const scan = heuristicScan([title, b.rate, description].join(' '));
    if (scan.rating === 'danger') { fail('This post looks like a scam pattern (' + scan.flags.join(', ') + '). Legit jobs never ask VAs to pay, use crypto, or move to Telegram.'); }
    const id = uid();
    await c.db.insert('jobs', { id, source_id: 'direct', source_url: '', title, company: clean(b.company, 120), location: clean(b.location, 120) || 'Remote', rate: clean(b.rate, 80),
      tags: clean(b.tags, 300), posted_at: new Date().toISOString().slice(0, 10), ingested_at: now(), safety_rating: 'safe', safety_flags: '[]', hash: 'direct:' + id,
      posted_by: u.id, status: 'pending_payment', description });
    return checkout(c, { ref_type: 'job_post', ref_id: id, amount: cfgNum(c, 'job_post_fee_php'), description: 'Job post (30 days): ' + title, back: '/jobs.html' });
  },
  async 'GET jobs/board'(c) {
    const u = needActive(c); const q = clean(c.query.q, 60);
    const rows = await c.db.all(`SELECT j.*, (SELECT 1 FROM job_applications a WHERE a.job_id = j.id AND a.user_id = ?) applied,
      (SELECT COUNT(*) FROM job_applications a WHERE a.job_id = j.id) applicants FROM jobs j
      WHERE j.status = 'live' AND (? = '' OR instr(lower(j.title || ' ' || ifnull(j.company,'') || ' ' || ifnull(j.tags,'')), lower(?)) > 0)
      ORDER BY (j.posted_by IS NOT NULL) DESC, j.ingested_at DESC LIMIT 100`, u.id, q, q);
    return { jobs: rows.map((j) => ({ id: j.id, title: j.title, company: j.company, location: j.location, rate: j.rate, tags: j.tags, description: j.description, url: j.source_url,
      direct: !!j.posted_by, mine: j.posted_by === u.id, applied: !!j.applied, applicants: j.posted_by === u.id ? j.applicants : undefined, safety: j.safety_rating, flags: pj(j.safety_flags, []) })) };
  },
  async 'POST jobs/apply'(c) {
    const u = needPriv(c, 'apply_jobs'); await rate(c, 'apply:' + u.id, 30, 86400);
    const j = await c.db.first("SELECT * FROM jobs WHERE id = ? AND status = 'live' AND posted_by IS NOT NULL", c.body.job_id) || fail('Job not found', 404);
    if (j.posted_by === u.id) fail("You can't apply to your own job.");
    const r = await c.db.run('INSERT OR IGNORE INTO job_applications (id, job_id, user_id, ts, note, status) VALUES (?,?,?,?,?,?)', uid(), j.id, u.id, now(), clean(c.body.note, 1500), 'applied');
    if (!r.meta.changes) fail('You already applied.', 409);
    await notify(c, j.posted_by, 'application', `${u.name} applied to "${j.title}"`, '/jobs.html#mine');
    return { ok: true };
  },
  async 'GET jobs/applicants'(c) {
    const u = needActive(c);
    const j = await c.db.first('SELECT * FROM jobs WHERE id = ?', clean(c.query.job_id, 60)) || fail('Job not found', 404);
    if (j.posted_by !== u.id && !STAFF.includes(u.role)) fail('Not your job.', 403);
    const rows = await c.db.all('SELECT a.ts, a.note, a.status, u.* FROM job_applications a JOIN users u ON u.id = a.user_id WHERE a.job_id = ? ORDER BY (u.pro_until > ?) DESC, u.va_rank DESC, u.sim_score DESC', j.id, now());
    return { applicants: rows.map((r) => ({ ...cardUser(r), rank_name: rankName(c, r.va_rank, r.account_type, r.role), note: r.note, applied_at: r.ts, channel: dmId(u.id, r.id) })) };
  },
  async 'GET jobs/mine'(c) {
    const u = needActive(c);
    return { jobs: await c.db.all('SELECT j.id, j.title, j.status, j.ingested_at, (SELECT COUNT(*) FROM job_applications a WHERE a.job_id = j.id) applicants FROM jobs j WHERE j.posted_by = ? ORDER BY j.ingested_at DESC', u.id) };
  },
};

// Free plan: limited AI role-plays per day (Pro is unlimited). Called by Circle Bestie before starting a new scenario.
export async function checkSimAllowance(c, u) {
  if (isPro(u) || STAFF.includes(u.role)) return;
  const start = new Date(); start.setUTCHours(-8, 0, 0, 0); // midnight Manila
  if (start.getTime() > now()) start.setUTCDate(start.getUTCDate() - 1);
  const n = (await c.db.first("SELECT COUNT(*) n FROM simulations WHERE user_id = ? AND ts >= ? AND scenario NOT LIKE 'sim:%'", u.id, start.getTime())).n;
  if (n >= cfgNum(c, 'free_ai_sims_per_day')) fail(`You've used today's ${cfgNum(c, 'free_ai_sims_per_day')} free AI simulations. Circle Academy simulators and lessons are unlimited, or go Tier 2 · Circle Pro for unlimited AI role-play.`, 402);
}
