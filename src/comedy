        badges = CASE WHEN instr(badges, '"Founding Ambassador 🌟"') THEN badges ELSE json_insert(badges, '$[#]', 'Founding Ambassador 🌟') END
        WHERE id = ? AND status = 'active' AND account_type = 'va' AND ambassador_until <= ?
        AND (SELECT COUNT(*) FROM users WHERE ambassador_until > ? AND status = 'active' AND account_type = 'va') < ?`,
        t + days * 864e5, t, days * 864e5, a.user_id, t, t, cap);
      if (!g.meta.changes) {
