export async function api(path, { method, body, form } = {}) {
  const opt = { method: method || (body || form ? 'POST' : 'GET'), credentials: 'same-origin', headers: {} };
  if (form) opt.body = form;
  else if (body) { opt.body = JSON.stringify(body); opt.headers['content-type'] = 'application/json'; }
  let r;
  try { r = await fetch('/api/' + path, opt); }
  catch { const e = new Error('Could not reach The Virtual Circle. Check your connection and try again.'); e.status = 0; e.offline = true; throw e; }
  // The API always answers in JSON. Anything else (a web page, a 404) means the site's API isn't running: say so instead of
  // carrying on as if it worked (which used to send people back to the sign-up form with no message).
  if (!(r.headers.get('content-type') || '').includes('application/json')) {
    const e = new Error("The Circle's server isn't answering right now. If you run this site, open /setup.html for a checklist.");
    e.status = r.status === 200 ? 503 : r.status; e.setup = true; throw e;
  }
  const data = await r.json().catch(() => ({}));
  if (!r.ok) { const e = new Error(data.error || 'Request failed'); e.status = r.status; e.setup = r.status === 503; throw e; }
  return data;
}
export const $ = (s, el = document) => el.querySelector(s);
export const $$ = (s, el = document) => [...el.querySelectorAll(s)];
export const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
export function say(el, text, kind = 'err') { el.textContent = text; el.className = 'msg ' + kind; }
export function toast(text, kind = '') {
  const t = document.createElement('div'); t.className = 'toast ' + kind; t.setAttribute('role', 'status'); t.textContent = text;
  document.body.append(t); setTimeout(() => t.remove(), 4200);
}
