      "INSERT INTO config (key, value, note) VALUES ('pro_price_php', '149', 'Tier 2 · Circle Pro membership, per 30 days'),\n ('job_post_fee_php', '299', 'Client fee to publish a direct job post for 30 days'),\n ('boost_fee_php', '199', 'Fee to boost a post to the top of the feed for 7 days'),\n ('free_ai_sims_per_day', '3', 'Circle Bestie AI simulations per day on the free plan'),\n ('rank_names', '{\"0\": \"Unverified\", \"1\": \"Verified Aspiring VA\", \"2\": \"Proven VA\", \"3\": \"Senior VA\", \"4\": \"Pod Leader\"}', 'Verification ranks shown on profiles'),\n ('rank_privileges', '{\"marketplace\": 1, \"post_feed\": 1, \"apply_jobs\": 1, \"mentor\": 2, \"dm_anyone\": 2, \"create_courses\": 3, \"pod_leader\": 4}', 'Minimum rank for each privilege (staff bypass)')",
      "INSERT INTO courses (id, title, summary, level, pro, status, author_id, sort, created_at) VALUES ('c-foundations', 'VA Foundations: Client Communication', 'Write updates clients trust, handle hard conversations, and protect your time.', 'Beginner', 0, 'published', 'system', 1, 0)",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-foundations-l1', 'c-foundations', 'The 3-part status update', 1, '[{\"title\": \"Why updates matter\", \"body\": \"Clients rarely complain about the work itself. They complain about not knowing what is happening. A clear update turns silence into trust.\"}, {\"title\": \"Done · Next · Blockers\", \"body\": \"Every update answers three questions:\\n• **Done**: what you finished since the last update\\n• **Next**: what you will do, with a time\\n• **Blockers**: anything you need from them\"}, {\"title\": \"Make it skimmable\", \"body\": \"Lead with the most important line. Use short bullets. Put times in the client''s time zone. End with a clear question if you need a decision.\"}, {\"title\": \"Example\", \"body\": \"Done: 42 support tickets closed, refund policy draft attached.\\nNext: inbox zero by 9am EST.\\nBlocker: need approval on the refund draft before Friday.\"}]', '[{\"q\": \"Which three parts make up a strong status update?\", \"choices\": [\"Greeting, story, sign-off\", \"Done, Next, Blockers\", \"Problems, excuses, apology\", \"Hours, rate, invoice\"], \"answer\": 1, \"explain\": \"Done / Next / Blockers tells the client progress, plans and what you need.\"}, {\"q\": \"Your client is in New York and you are in Manila. How should you write deadlines?\", \"choices\": [\"In Manila time\", \"In the client''s time zone\", \"Without times\", \"In UTC only\"], \"answer\": 1, \"explain\": \"Use the client''s time zone so they never have to convert.\"}, {\"q\": \"Where should the most important information go?\", \"choices\": [\"At the end\", \"In an attachment\", \"In the first line\", \"In a separate email\"], \"answer\": 2, \"explain\": \"Lead with what matters most; busy clients skim.\"}]', 70, '')",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-foundations-l2', 'c-foundations', 'Calming an upset client', 2, '[{\"title\": \"Acknowledge first\", \"body\": \"Before fixing anything, show you heard them: \\\"I understand this is frustrating, and I''m on it.\\\"\"}, {\"title\": \"Own your part, no excuses\", \"body\": \"If it was your mistake, say so once, plainly. Long explanations sound like excuses.\"}, {\"title\": \"Give a concrete next step + time\", \"body\": \"\\\"I''ve paused the campaign. I''ll send the corrected email within 30 minutes and update you by 4pm.\\\"\"}, {\"title\": \"Prevent the repeat\", \"body\": \"Close with what you''ll change: a checklist, a second review, a test send.\"}]', '[{\"q\": \"What should come first when a client is upset?\", \"choices\": [\"A detailed explanation\", \"Acknowledging their frustration\", \"Your rate increase\", \"Silence until it''s fixed\"], \"answer\": 1, \"explain\": \"Acknowledgement lowers the temperature so they can hear your plan.\"}, {\"q\": \"Which reply is strongest?\", \"choices\": [\"Sorry, the system did it.\", \"I''ll look into it eventually.\", \"I''ve paused it and will send the fix in 30 minutes, then add a test-send step.\", \"It''s not my fault.\"], \"answer\": 2, \"explain\": \"It acts immediately, gives a time, and prevents a repeat.\"}]', 70, '')",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-foundations-l3', 'c-foundations', 'Saying no to scope creep', 3, '[{\"title\": \"Scope creep is normal\", \"body\": \"Clients add ''quick'' tasks without noticing. Your job is to make the trade-off visible, kindly.\"}, {\"title\": \"The yes-and formula\", \"body\": \"\\\"Happy to help with Instagram! It''s outside our current scope, so I can add it at $X/hr or swap it for the newsletter this week. Which do you prefer?\\\"\"}, {\"title\": \"Protect your rest\", \"body\": \"Weekend or off-hours work should be agreed and paid. Saying so early keeps the relationship healthy.\"}]', '[{\"q\": \"A client asks for unpaid weekend work ''for exposure''. Best response?\", \"choices\": [\"Accept to keep them happy\", \"Ignore the message\", \"Offer it as paid extra work or a swap of priorities\", \"Quit immediately\"], \"answer\": 2, \"explain\": \"Offer clear options; never work unpaid.\"}]', 70, '')",
      "INSERT INTO courses (id, title, summary, level, pro, status, author_id, sort, created_at) VALUES ('c-scamproof', 'Scam-Proof Freelancing', 'Spot fake jobs, protect your identity, and get paid safely.', 'Beginner', 0, 'published', 'system', 2, 0)",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-scamproof-l1', 'c-scamproof', 'The 6 red flags', 1, '[{\"title\": \"Legit clients and employers never ask you to pay\", \"body\": \"Training fees, starter kits, ''refundable deposits'': if an employer or recruiter makes you pay to get hired, it''s a scam. Optional memberships you choose on a platform are different: nobody can require one to hire you.\"}, {\"title\": \"Watch the money trail\", \"body\": \"Crypto payouts, ''recharge'' tasks, and pay-per-like schemes are classic traps.\"}, {\"title\": \"Too good to be true\", \"body\": \"$40/hr data entry with no experience and no interview is bait.\"}, {\"title\": \"Off-platform pressure\", \"body\": \"''Message HR on Telegram'' moves you where no one can protect you. Keep it on-platform.\"}]', '[{\"q\": \"A recruiter asks for a ₱1,500 ''refundable training fee''. This is…\", \"choices\": [\"Normal onboarding\", \"A red flag: never pay to work\", \"A tax requirement\", \"A bonus\"], \"answer\": 1, \"explain\": \"Legitimate employers pay you, not the other way round.\"}, {\"q\": \"Which payment method is a common scam signal?\", \"choices\": [\"Bank transfer from a registered company\", \"PayPal invoice\", \"Salary paid in USDT crypto\", \"Payroll platform\"], \"answer\": 2, \"explain\": \"Crypto-only pay is a strong warning sign.\"}, {\"q\": \"Why keep chats on the platform?\", \"choices\": [\"It''s faster\", \"Scam reports and protections only work on-platform\", \"Clients prefer it\", \"No reason\"], \"answer\": 1, \"explain\": \"On-platform chats can be flagged and reviewed.\"}]', 70, '')",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-scamproof-l2', 'c-scamproof', 'Protect your identity', 2, '[{\"title\": \"Share ID only when needed\", \"body\": \"Only send government ID to verified employers, through secure channels, after an interview.\"}, {\"title\": \"Never share OTPs or passwords\", \"body\": \"No real client needs your bank OTP, GCash PIN or email password.\"}, {\"title\": \"Report it\", \"body\": \"Paste suspicious offers into Circle Scam-Buster to warn the whole circle.\"}]', '[{\"q\": \"A ''client'' asks for your GCash OTP to send payment. You should…\", \"choices\": [\"Send it\", \"Refuse and report\", \"Send half of it\", \"Ask a friend\"], \"answer\": 1, \"explain\": \"Payments never require your OTP.\"}]', 70, '')",
      "INSERT INTO courses (id, title, summary, level, pro, status, author_id, sort, created_at) VALUES ('c-exec', 'Executive Support Essentials', 'Inbox triage, calendar management across time zones, and accurate data handling, with hands-on simulators.', 'Intermediate', 1, 'published', 'system', 3, 0)",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-exec-l1', 'c-exec', 'Inbox triage in 4 buckets', 1, '[{\"title\": \"The 4 buckets\", \"body\": \"**Urgent**: needs action today. **Reply**: needs a response, not urgent. **Delegate**: someone else should handle it. **Archive**: FYI, receipts, newsletters.\"}, {\"title\": \"Decide once\", \"body\": \"Touch each email once: decide its bucket, act or schedule it, move on.\"}, {\"title\": \"Practice\", \"body\": \"Open the Inbox Triage simulator and sort 10 real-world emails against the clock.\"}]', '[{\"q\": \"A server-down alert from the CTO goes to…\", \"choices\": [\"Archive\", \"Urgent\", \"Delegate\", \"Reply\"], \"answer\": 1, \"explain\": \"Outages need same-day action.\"}, {\"q\": \"A monthly newsletter goes to…\", \"choices\": [\"Urgent\", \"Reply\", \"Archive\", \"Delegate\"], \"answer\": 2, \"explain\": \"FYI content is archived.\"}]', 70, 'inbox')",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-exec-l2', 'c-exec', 'Scheduling across time zones', 2, '[{\"title\": \"Find the overlap\", \"body\": \"List each attendee''s working hours in one time zone, then look for the overlap.\"}, {\"title\": \"Manila is UTC+8\", \"body\": \"New York is UTC−5 (−4 in summer), London UTC+0 (+1 in summer), Sydney UTC+10 (+11 in summer).\"}, {\"title\": \"Practice\", \"body\": \"Use the Calendar simulator to place meetings everyone can attend.\"}]', '[{\"q\": \"When it is 9:00 PM in Manila (UTC+8), what time is it in UTC?\", \"choices\": [\"1:00 PM\", \"9:00 AM\", \"5:00 AM\", \"11:00 PM\"], \"answer\": 0, \"explain\": \"9 PM minus 8 hours is 1 PM UTC.\"}]', 70, 'calendar')",
      "INSERT INTO lessons (id, course_id, title, position, slides, quiz, pass_pct, simulator) VALUES ('c-exec-l3', 'c-exec', 'Accurate data entry', 3, '[{\"title\": \"Accuracy beats speed\", \"body\": \"One wrong digit in an invoice costs more than five minutes saved.\"}, {\"title\": \"Check as you go\", \"body\": \"Read back each record before moving on; watch for O vs 0 and l vs 1.\"}, {\"title\": \"Practice\", \"body\": \"The Data Entry simulator scores both speed and accuracy.\"}]', '[{\"q\": \"Which matters more for client trust?\", \"choices\": [\"Speed\", \"Accuracy\", \"Font choice\", \"Emoji use\"], \"answer\": 1, \"explain\": \"Clients remember errors more than speed.\"}]', 70, 'dataentry')"
