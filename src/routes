  async 'POST otp/send'(c) {
    const u = need(c); if (u.mobile_verified) return { ok: true };
    await rate(c, 'otp:' + u.id, 3, 300); await sendOtp(c, u); return { ok: true };
  },
  async 'POST otp/verify'(c) {
    const u = need(c);
    const o = await c.db.first('SELECT * FROM otps WHERE user_id = ?', u.id);
    if (!o || o.expires_at < now()) fail('Code expired. Tap resend.');
    if (o.tries >= 5) { await c.db.run('DELETE FROM otps WHERE user_id = ?', u.id); fail('Too many wrong codes. Tap resend.', 429); }
    if (!safeEqual(await sha256(clean(c.body.code, 6) + u.id), o.code_hash)) { await c.db.run('UPDATE otps SET tries = tries + 1 WHERE user_id = ?', u.id); fail('That code is not right.'); }
    await c.db.batch([c.db.stmt('DELETE FROM otps WHERE user_id = ?', u.id),
      c.db.updateStmt('users', u.id, { mobile_verified: 1, status: u.status === 'pending_otp' ? 'pending_kyc' : u.status })]);
    return { ok: true, next: 'kyc' };
  },
  async 'POST profile/update'(c) {
    const u = need(c); const b = c.body; const patch = {};
    for (const k of ['bio', 'region', 'hub', 'skills', 'address']) if (b[k] !== undefined) patch[k] = clean(b[k], k === 'bio' ? 600 : 200);
    if (b.rate !== undefined) patch.rate = clean(b.rate, 40);
    if (b.payout_account !== undefined) { const p = clean(b.payout_account, 20).replace(/[\s-]/g, ''); if (p && !/^(\+63|0)9\d{9}$/.test(p)) fail('GCash number format: 09XXXXXXXXX'); patch.payout_account = p; }
    if (b.tin !== undefined) { const tin = clean(b.tin, 20); if (tin && !/^\d{3}-?\d{3}-?\d{3}(-?\d{3,5})?$/.test(tin)) fail('TIN format: 000-000-000-000'); patch.tin = tin; }
    if (patch.bio && OFF_PLATFORM.test(patch.bio)) { patch.bio = patch.bio.replace(new RegExp(OFF_PLATFORM.source, 'gi'), '').trim(); await penalize(c, u, 'off_platform', 'Contact details in profile bio'); }
    if (Object.keys(patch).length) await c.db.update('users', u.id, patch);
    return { user: publicUser({ ...u, ...patch }) };
  },
  // Verification. Aspiring (newbie) VAs: Government ID + selfie. Tenured (seasoned) VAs: ID + selfie + proof of work
  // experience and employment. Active members can later submit kind=upgrade with more proof to raise their rank.
  async 'POST kyc/submit'(c) {
    const u = need(c); const b = c.body;
    const upgrade = b.kind === 'upgrade';
    if (!u.mobile_verified) fail('Verify your mobile number first.');
    if (upgrade ? u.status !== 'active' : ['kyc_review', 'active'].includes(u.status)) fail(upgrade ? 'Finish your first verification before requesting a higher rank.' : 'Your verification is already submitted.', 409);
    if (upgrade && (await c.db.first("SELECT 1 FROM kyc WHERE user_id = ? AND status = 'pending'", u.id))) fail('You already have a request under review.', 409);
    if (storageMode(c) === 'none') fail('ID uploads open soon: our team is finishing setup. Please try again later.', 503);
    await rate(c, 'kyc:' + u.id, 3, 3600);
    const checkFile = (f, types, label) => {
      if (!f || typeof f === 'string') fail(`Upload ${label}.`);
      if (!types.includes(f.type)) fail(types.includes('application/pdf') ? 'Proof documents must be JPG, PNG, WebP or PDF.' : 'Photos must be JPG, PNG or WebP.');
      if (f.size > MAX_IMG) fail('Each file must be under 5 MB.');
    };
    const proofs = ['proof_1', 'proof_2', 'proof_3'].map((k) => b[k]).filter((f) => f && typeof f !== 'string' && f.size);
    const needsExperience = upgrade || (u.account_type === 'va' && u.tier === 'seasoned');
    let experience = {};
    if (needsExperience) {
      experience = { years: Math.max(0, Math.min(40, Number(b.years) || 0)), roles: clean(b.roles, 600), employers: clean(b.employers, 600), reference: clean(b.reference, 300) };
      if (experience.years < 1) fail('Tenured VAs need at least 1 year of experience. Choose "Aspiring" if you are just starting.');
      if (experience.roles.length < 20) fail('Describe your VA roles and main tasks (20+ characters).');
      if (!proofs.length) fail('Upload at least one proof of work: certificate of employment, contract, payslip or client reference.');
      proofs.forEach((f) => checkFile(f, [...IMG_TYPES, 'application/pdf'], 'proof of work'));
    }
    const flags = []; let idHash = '', idKey = '', selfieKey = '', fp = u.fingerprint;
    const id = uid();
    if (!upgrade) {
      const idNo = clean(b.id_number, 40).replace(/[\s-]/g, '').toUpperCase();
      if (idNo.length < 5) fail('Enter your ID number.');
      checkFile(b.id_file, IMG_TYPES, 'a photo of your ID'); checkFile(b.selfie_file, IMG_TYPES, 'a selfie');
      if (!c.env.PEPPER) fail('Server is missing PEPPER.', 500);
      idHash = await hmac(c.env.PEPPER, clean(b.id_type, 30) + ':' + idNo);
      if (await c.db.first('SELECT 1 FROM kyc WHERE id_hash = ? AND user_id <> ?', idHash, u.id)) { flags.push('duplicate_id'); await penalize(c, u, 'dup_id', 'Government ID already used by another account', 'high'); }
      fp = b.fingerprint ? await sha256(String(b.fingerprint)) : u.fingerprint;
      if (fp && await c.db.first('SELECT 1 FROM users WHERE fingerprint = ? AND id <> ?', fp, u.id)) flags.push('duplicate_device');
      idKey = await putFile(c, { folder: 'kyc', name: `${u.id}-${id}-id`, bytes: await b.id_file.arrayBuffer(), contentType: b.id_file.type });
      selfieKey = await putFile(c, { folder: 'kyc', name: `${u.id}-${id}-selfie`, bytes: await b.selfie_file.arrayBuffer(), contentType: b.selfie_file.type });
    }
    const proofKeys = [];
    for (const [i, f] of proofs.entries()) proofKeys.push(await putFile(c, { folder: 'kyc', name: `${u.id}-${id}-proof${i + 1}`, bytes: await f.arrayBuffer(), contentType: f.type }));
    const stmts = [c.db.insertStmt('kyc', { id, user_id: u.id, kind: upgrade ? 'upgrade' : needsExperience ? 'tenured' : 'identity', id_type: upgrade ? '—' : clean(b.id_type, 30), id_hash: idHash,
      id_file: idKey, selfie_file: selfieKey, proof_files: proofKeys, experience, fingerprint: fp, status: 'pending', flags, created_at: now() })];
    if (!upgrade) stmts.push(c.db.updateStmt('users', u.id, { status: 'kyc_review' }));
    await c.db.batch(stmts);
    return { ok: true, flags: flags.length };
  },

