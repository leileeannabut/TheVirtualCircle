/* Nocturnal Sanctuary — dark-first, calm, airy ("maaliwalas") */
:root{
  --bg:#0b1226; --bg-2:#111a33; --card:#141f3d; --line:#25335c;
  --text:#e9edf7; --muted:#9aa7c7; --amber:#f5b94a; --amber-2:#ffd88a; --amber-ink:#2a1c00;
  --ok:#7ad9a6; --bad:#ff8a8a;
  --r:16px; --gap:1.5rem; --font:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
}
*{box-sizing:border-box} html{color-scheme:dark}
body{margin:0;background:radial-gradient(1200px 600px at 70% -10%,#18244a 0%,var(--bg) 60%);color:var(--text);
  font:16px/1.7 var(--font);min-height:100vh;letter-spacing:.01em}
a{color:var(--amber-2)} h1,h2,h3{line-height:1.25;font-weight:650;margin:0 0 .6rem}
.wrap{max-width:1040px;margin:0 auto;padding:2rem 1.25rem}
.nav{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0}
.brand{font-weight:700;color:var(--amber);text-decoration:none;font-size:1.15rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:1.75rem}
.grid{display:grid;gap:var(--gap)} .g3{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.muted{color:var(--muted)}
.btn{display:inline-block;border:0;border-radius:999px;padding:.8rem 1.5rem;font:inherit;font-weight:650;cursor:pointer;
  background:var(--amber);color:var(--amber-ink);text-decoration:none;transition:.15s}
.btn:hover{background:var(--amber-2)} .btn.ghost{background:transparent;color:var(--amber-2);border:1px solid var(--line)}
.btn:disabled{opacity:.5;cursor:wait}
label{display:block;margin:1rem 0 .3rem;color:var(--muted);font-size:.9rem}
input,select{width:100%;padding:.8rem 1rem;border-radius:12px;border:1px solid var(--line);background:var(--bg-2);color:var(--text);font:inherit}
input:focus,select:focus{outline:2px solid var(--amber);outline-offset:1px}
.msg{min-height:1.5rem;margin-top:1rem} .msg.err{color:var(--bad)} .msg.ok{color:var(--ok)}
.tabs{display:flex;gap:.5rem;margin-bottom:1rem}
.tab{flex:1;text-align:center;padding:.6rem;border-radius:12px;border:1px solid var(--line);cursor:pointer;background:none;color:var(--muted);font:inherit}
.tab.on{background:var(--bg-2);color:var(--amber-2);border-color:var(--amber)}
.hero{padding:4rem 0 2rem;text-align:center} .hero h1{font-size:clamp(2rem,5vw,3.4rem)}
.count{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin:2rem 0}
.count div{min-width:110px;text-align:center}.count b{display:block;font-size:2.4rem;color:var(--amber)}
.hidden{display:none} table{width:100%;border-collapse:collapse} td,th{padding:.7rem;border-bottom:1px solid var(--line);text-align:left}
img.kyc{max-width:100%;border-radius:12px;border:1px solid var(--line)}
@media (prefers-reduced-motion:no-preference){.card{animation:rise .5s ease both}@keyframes rise{from{opacity:0;transform:translateY(8px)}}}
