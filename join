<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Join — The Virtual Circle</title><link rel="stylesheet" href="/css/tokens.css"></head>
<body><div class="wrap" style="max-width:520px">
<nav class="nav"><a class="brand" href="/">✨ The Virtual Circle</a></nav>
<div class="card">
 <div id="auth">
  <div class="tabs"><button class="tab on" data-t="reg">Join</button><button class="tab" data-t="login">Sign in</button></div>
  <form id="reg">
   <label>Full name</label><input name="name" required autocomplete="name">
   <label>Email</label><input name="email" type="email" required autocomplete="email">
   <label>Mobile (PH)</label><input name="mobile" placeholder="09XXXXXXXXX" required autocomplete="tel">
   <label>Password (10+ characters)</label><input name="password" type="password" minlength="10" required autocomplete="new-password">
   <label>I am a…</label><select name="tier"><option value="newbie">Newbie VA</option><option value="seasoned">Seasoned VA</option></select>
   <p><button class="btn" style="width:100%">Create my account</button></p>
  </form>
  <form id="login" class="hidden">
   <label>Email</label><input name="email" type="email" required autocomplete="email">
   <label>Password</label><input name="password" type="password" required autocomplete="current-password">
   <p><button class="btn" style="width:100%">Sign in</button></p>
  </form>
 </div>
 <form id="otp" class="hidden"><h2>Confirm your mobile</h2><p class="muted">We sent a 6-digit code by SMS.</p>
  <label>Code</label><input name="code" inputmode="numeric" maxlength="6" required>
  <p><button class="btn" style="width:100%">Verify</button> <a href="#" id="resend" class="muted">Resend code</a></p></form>
 <form id="kyc" class="hidden"><h2>Verify it's really you</h2><p class="muted">This keeps the Circle scam-free. Files are stored privately and only our review team can see them.</p>
  <label>ID type</label><select name="id_type"><option value="philsys">PhilSys National ID</option><option value="drivers_license">Driver's License</option><option value="passport">Passport</option><option value="umid">UMID</option><option value="prc">PRC ID</option><option value="other">Other government ID</option></select>
  <label>ID number</label><input name="id_number" required>
  <label>Photo of your ID</label><input name="id_photo" type="file" accept="image/*" required>
  <label>A clear selfie</label><input name="selfie" type="file" accept="image/*" capture="user" required>
  <p><button class="btn" style="width:100%">Submit for review</button></p></form>
 <div id="review" class="hidden"><h2>You're in the queue 🌙</h2><p class="muted">We're reviewing your documents. You'll be able to enter the Circle as soon as you're approved.</p><button class="btn ghost" id="out">Sign out</button></div>
 <div id="done" class="hidden"><h2>Welcome to the Circle ✨</h2><p class="muted">Your account is verified. The community opens in the next release.</p><button class="btn ghost" id="out2">Sign out</button></div>
 <div id="m" class="msg"></div>
</div></div>
<script type="module">
import {api,$,say,fingerprint} from '/js/app.js';
const m=$('#m'),steps=['auth','otp','kyc','review','done'];
const show=id=>{steps.forEach(s=>$('#'+s).classList.toggle('hidden',s!==id));m.textContent=''};
async function route(){const {user}=await api('me');if(!user)return show('auth');
 if(user.status==='suspended'){show('auth');return say(m,'This account is suspended.')}
 show({pending_otp:'otp',pending_kyc:'kyc',in_review:'review',active:'done'}[user.status]||'auth')}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x===b));
 $('#reg').classList.toggle('hidden',b.dataset.t!=='reg');$('#login').classList.toggle('hidden',b.dataset.t!=='login');m.textContent=''});
const go=(form,fn)=>form.addEventListener('submit',async e=>{e.preventDefault();const btn=form.querySelector('button');btn.disabled=true;
 try{await fn(Object.fromEntries(new FormData(form)),new FormData(form));await route()}catch(err){say(m,err.message)}finally{btn.disabled=false}});
go($('#reg'),async d=>{d.fp=await fingerprint();await api('auth/register',{method:'POST',body:d})});
go($('#login'),d=>api('auth/login',{method:'POST',body:d}));
go($('#otp'),d=>api('auth/otp/verify',{method:'POST',body:d}));
go($('#kyc'),(d,f)=>api('kyc/submit',{method:'POST',form:f}));
$('#resend').onclick=async e=>{e.preventDefault();try{await api('auth/otp/request',{method:'POST'});say(m,'New code sent.','ok')}catch(err){say(m,err.message)}};
for(const id of ['out','out2'])$('#'+id).onclick=async()=>{await api('auth/logout',{method:'POST'});route()};
route();
</script></body></html>
