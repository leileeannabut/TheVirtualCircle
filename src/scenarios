export function offlineReply(n) {
  const lines = ['Okay… and how exactly will that fix it?', 'I need a timeline. When will this be done?', 'Fine. What do you need from me right now?', 'Alright, that helps. Anything else I should know?'];
  return lines[Math.min(Math.floor(n / 2), lines.length - 1)] + ' (Offline practice mode: add GEMINI_API_KEY for live role-play.)';
}

export function offlineGrade(text) {
  const t = text.toLowerCase(); const has = (re) => (re.test(t) ? 1 : 0);
  const comm = Math.min(100, 50 + 15 * has(/sorry|apolog|understand|i hear/) + 15 * has(/will|i'll|plan|next step/) + 10 * has(/thank/) + 10 * has(/update|by \d|minutes|hour/));
  const tech = Math.min(100, 50 + 20 * has(/check|test|log|settings|clear|cache|restart|backup/) + 20 * has(/step|first|then/) + 10 * has(/screenshot|record/));
  const crisis = Math.min(100, 50 + 20 * has(/immediately|right now|first|contain|pause|revoke/) + 15 * has(/notify|inform|escalate/) + 15 * has(/prevent|going forward|checklist/));
  return { communication: comm, technical: tech, crisis, overall: Math.round((comm + tech + crisis) / 3),
    feedback: '• Scored with offline rules (add GEMINI_API_KEY for AI grading).\n• Acknowledge feelings, then give a concrete next step and a time.\n• Close with how you will prevent it next time.' };
}
