    const format = Object.prototype.hasOwnProperty.call(FORMATS, c.body.format || '') ? c.body.format : fail('Pick a format.');
    await guard(c, u, JSON.stringify(c.body.body || ''));
    const body = await cleanBody(c, u, format, c.body.body);
    const tags = [...new Set((JSON.stringify(body).match(/#[\p{L}\p{N}_]{2,30}/gu) || []).map((t) => t.slice(1).toLowerCase()))].slice(0, 6).join(' ');
    const prompt = c.body.prompt_id ? await c.db.first('SELECT id FROM comedy_prompts WHERE id = ?', clean(c.body.prompt_id, 40)) : null;
    const p = await c.db.insert('comedy_posts', { ts: now(), user_id: u.id, format, body, tags, prompt_id: prompt?.id || null, anonymous: !!c.body.anonymous, podcast_ok: !!c.body.podcast_ok,
