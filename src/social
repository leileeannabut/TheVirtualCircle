};
export const detectTopics = (text) => Object.entries(TOPICS).filter(([, t]) => t.re.test(text)).map(([id]) => id);

async function autoMatch(c, user, topic, mode) {
  const made = [];
  const exists = (a, b) => c.db.first('SELECT 1 FROM bff_matches WHERE topic = ? AND ((a = ? AND b = ?) OR (a = ? AND b = ?))', topic, a, b, b, a);
  const pick = (m) => c.db.first(`SELECT s.user_id, u.name FROM struggles s JOIN users u ON u.id = s.user_id
    WHERE s.topic = ? AND s.mode = ? AND s.active = 1 AND s.user_id <> ? AND u.status = 'active'
      AND NOT EXISTS (SELECT 1 FROM bff_matches x WHERE x.topic = s.topic AND ((x.a = s.user_id AND x.b = ?) OR (x.b = s.user_id AND x.a = ?)))
    ORDER BY (u.hub = ?) DESC, u.va_rank DESC, (SELECT COUNT(*) FROM bff_matches y WHERE y.b = s.user_id AND y.status = 'active') ASC, s.ts ASC LIMIT 1`, topic, m, user.id, user.id, user.id, user.hub || '');
  const label = TOPICS[topic].label;
  const link = async (a, b, kind, otherName, selfName) => {
    if (await exists(a, b)) return;
    await c.db.insert('bff_matches', { ts: now(), a, b, topic, kind, status: 'active' });
    const ch = encodeURIComponent(dmId(a, b));
    const msg = kind === 'mentor' ? `found someone who has been through "${label}"` : `found someone going through "${label}" too`;
    await c.db.insert('notifications', { ts: now(), user_id: a, type: 'bff', text: `Circle BFF ${msg}: ${kind === 'mentor' ? otherName : otherName}. Say hi 💛`, link: '/messages.html#' + ch, read: 0 });
    await c.db.insert('notifications', { ts: now(), user_id: b, type: 'bff', text: `Circle BFF: ${selfName} ${kind === 'mentor' ? 'is going through' : 'is also going through'} "${label}". You can help each other 💛`, link: '/messages.html#' + ch, read: 0 });
    made.push({ with: otherName, kind });
  };
  if (mode === 'going_through') {
    const helper = await pick('been_through'); if (helper) await link(user.id, helper.user_id, 'mentor', helper.name, user.name);
    const peer = await pick('going_through'); if (peer) await link(user.id, peer.user_id, 'peer', peer.name, user.name);
  } else {
    const seeker = await c.db.first(`SELECT s.user_id, u.name FROM struggles s JOIN users u ON u.id = s.user_id WHERE s.topic = ? AND s.mode = 'going_through' AND s.active = 1 AND s.user_id <> ? AND u.status = 'active'
      AND NOT EXISTS (SELECT 1 FROM bff_matches x WHERE x.topic = s.topic AND x.a = s.user_id AND x.kind = 'mentor') ORDER BY s.ts ASC LIMIT 1`, topic, user.id);
    if (seeker) await link(seeker.user_id, user.id, 'mentor', user.name, seeker.name);
  }
  return made;
}

// ── Learning helpers ──
async function courseProgress(c, userId, courseId) {
  return c.db.first(`SELECT (SELECT COUNT(*) FROM lessons WHERE course_id = ?1) total,
    (SELECT COUNT(*) FROM lesson_progress WHERE user_id = ?2 AND course_id = ?1 AND passed = 1) passed`, courseId, userId);
}
const canAuthor = (c, u) => can(c, u, 'create_courses');
function cleanSlides(x) { return (Array.isArray(x) ? x : []).slice(0, 40).map((s) => ({ title: clean(s.title, 120), body: clean(s.body, 2000).replace(/\\n/g, '\n') })).filter((s) => s.title || s.body); }
function cleanQuiz(x) {
  return (Array.isArray(x) ? x : []).slice(0, 30).map((q) => {
    const choices = (Array.isArray(q.choices) ? q.choices : []).map((ch) => clean(ch, 200)).filter(Boolean).slice(0, 6);
    return { q: clean(q.q, 300), choices, answer: Math.max(0, Math.min(choices.length - 1, Number(q.answer) || 0)), explain: clean(q.explain, 400) };
  }).filter((q) => q.q && q.choices.length >= 2);
}

