// ── access helpers ──
export function need(c, roles) {
  if (!c.user) fail('Please sign in.', 401);
  if (c.user.status === 'suspended') fail('Your account is suspended pending review.', 403);
  if (roles && !roles.includes(c.user.role)) fail('You do not have access to this.', 403);
  return c.user;
}
export function needActive(c, roles) {
  const u = need(c, roles);
  if (u.status !== 'active' && !STAFF.includes(u.role)) fail('Finish verification (OTP + KYC) to unlock this.', 403);
  return u;
}
