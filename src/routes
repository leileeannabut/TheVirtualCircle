export async function addBadge(c, userId, badge) {
  const u = await c.db.first('SELECT badges FROM users WHERE id = ?', userId); if (!u) return;
  const list = pj(u.badges, []); if (!list.includes(badge)) { list.push(badge); await c.db.update('users', userId, { badges: list }); }
}
export const dmId = (a, b) => 'dm:' + [a, b].sort().join(':');
async function dmAllowed(c, ch) {
  const ids = ch.slice(3).split(':');
  if (!ids.includes(c.user.id) && !STAFF.includes(c.user.role)) fail('Not your conversation.', 403);
  if (!(await canDm(c, ids[0], ids[1]))) fail('This conversation is not open yet. Connect first, or wait for a match.', 403);
}
async function vote(c, type, id, value) {
  const r = await c.db.run('INSERT OR IGNORE INTO votes (id, ts, user_id, target_type, target_id, value) VALUES (?,?,?,?,?,?)', uid(), now(), c.user.id, type, id, value);
  return r.meta.changes > 0;
}
async function upsertCompany(c, name, website, flags, addReports, verified) {
  const key = name.toLowerCase().replace(/[^a-z0-9]/g, '');
  await c.db.run('INSERT OR IGNORE INTO companies (id, name, name_key, website, updated_at) VALUES (?,?,?,?,?)', uid(), name, key, website || '', now());
  const co = await c.db.first('SELECT * FROM companies WHERE name_key = ?', key);
  const f = pj(co.flags, []); (flags || []).forEach((x) => { if (!f.includes(x)) f.push(x); });
  const patch = { flags: f.slice(0, 12), reports: co.reports + (addReports || 0), updated_at: now() };
  if (website && !co.website) patch.website = website;
  if (verified) patch.status = 'verified_risk';
  Object.assign(co, patch);
  await scoreCompany(c, co, patch);
  return co;
}
async function scoreCompany(c, co, patch = {}) {
  const v = await c.db.first("SELECT COUNT(*) n FROM scam_reports WHERE status = 'verified' AND lower(company) = lower(?)", co.name);
  const score = Math.min(100, co.reports * 12 + co.upvotes * 3 + v.n * 20 + pj(co.flags, []).length * 4);
  const status = co.status === 'verified_risk' ? co.status : score >= 70 ? 'high_risk' : score >= 35 ? 'elevated' : 'watch';
  Object.assign(co, { risk_score: score, status });
  await c.db.update('companies', co.id, { ...patch, risk_score: score, status });
}
async function sendOtp(c, u) {
  const code = String(crypto.getRandomValues(new Uint32Array(1))[0] % 1e6).padStart(6, '0');
  await c.db.run('INSERT OR REPLACE INTO otps (user_id, code_hash, tries, expires_at) VALUES (?,?,0,?)', u.id, await sha256(code + u.id), now() + 300000);
  await sendSms(c, u.mobile, `Your Virtual Circle code is ${code}. It expires in 5 minutes. Never share it.`);
}
const maskLicense = (l) => (String(l).length > 3 ? '•••' + String(l).slice(-3) : l);
const strip = (o, ...keys) => { const x = { ...o }; keys.forEach((k) => delete x[k]); return x; };

