    const u = needActive(c); const q = c.query;
    const before = Number(q.before) || now() + 1;
    const where = ['p.removed = 0', 'p.ts < ?']; const args = [before];
    if (Object.prototype.hasOwnProperty.call(FORMATS, q.format || '')) { where.push('p.format = ?'); args.push(q.format); }
    if (q.prompt) { where.push('p.prompt_id = ?'); args.push(clean(q.prompt, 40)); }
    if (q.stories) where.push('p.podcast_ok = 1');
    const order = q.sort === 'top' ? 'p.laughs DESC, p.ts DESC' : 'p.ts DESC';
    if (q.sort === 'top') { where.push('p.ts > ?'); args.push(now() - WEEK); }
    const rows = await c.db.all(`SELECT p.*, ${AUTHOR} FROM comedy_posts p JOIN users u ON u.id = p.user_id WHERE ${where.join(' AND ')} ORDER BY ${order} LIMIT 20`, ...args);
    const rx = await reactionCounts(c, rows.map((r) => r.id), u.id);
    return { formats: Object.fromEntries(Object.entries(FORMATS).map(([k, v]) => [k, v.label])),
      posts: rows.map((r) => ({ id: r.id, ts: r.ts, format: r.format, body: pj(r.body, {}), tags: r.tags ? r.tags.split(' ') : [], laughs: r.laughs, comments: r.comments,
        featured: !!r.featured, podcast_ok: !!r.podcast_ok, prompt_id: r.prompt_id, mine: r.user_id === u.id, author: authorOf(c, r, r.anonymous),
        reactions: rx[r.id]?.counts || {}, my_reaction: rx[r.id]?.mine || null })),
      next: q.sort !== 'top' && rows.length === 20 ? rows[rows.length - 1].ts : null };
  },
  async 'POST comedy/post'(c) {
