      await c.db.update('kyc', k.id, { rank_granted: rank });
      if (u.account_type === 'va' && !u.founder_slot) {
        // Founders slots: the UNIQUE index on founder_slot makes concurrent approvals safe (retry with the next number).
        const cap = cfgNum(c, u.tier === 'newbie' ? 'founders_newbie_cap' : 'founders_seasoned_cap');
        for (let tries = 0; tries < 5 && !slot; tries++) {
          const taken = (await c.db.first('SELECT COUNT(*) n FROM users WHERE founder_slot IS NOT NULL AND tier = ?', u.tier)).n;
          if (taken >= cap) break;
          try { await c.db.update('users', u.id, { founder_slot: `${u.tier}-${taken + 1}` }); slot = `${u.tier}-${taken + 1}`; } catch (e) { if (!/UNIQUE/.test(e.message)) throw e; }
