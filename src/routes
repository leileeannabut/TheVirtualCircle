  // ───────── Circle Bestie academy ─────────
  async 'GET academy/scenarios'(c) { return { scenarios: SCENARIOS.map(({ id, title, skill, brief }) => ({ id, title, skill, brief })), ai: !!c.env.GEMINI_API_KEY }; },
