      await c.db.insert('notifications', { ts: now(), user_id: u.id, type: 'rank', text: `🎉 Your rank is now ${rankNames[rank] || rank}. New privileges unlocked.`, link: '/app.html', read: 0 });
      await audit(c, 'rank_upgrade', u.id, String(rank));
      return { ok: true, rank };
    }
    if (!approve && k.kind === 'upgrade') {
      await c.db.insert('notifications', { ts: now(), user_id: u.id, type: 'rank', text: 'Your rank request needs more proof.' + (note ? ' Note: ' + note : ''), link: '/app.html', read: 0 });
