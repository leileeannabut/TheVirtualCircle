    const rows = await c.db.all("SELECT * FROM podcast_episodes WHERE status = 'published' ORDER BY number DESC, ts DESC LIMIT 50");
    const ids = [...new Set(rows.flatMap((e) => e.host_ids.split(',')).filter(Boolean))];
    const people = ids.length ? await c.db.all(`SELECT id, name FROM users WHERE id IN (${ids.map(() => '?').join(',')}) AND account_type <> 'host'`, ...ids) : [];
    const names = Object.fromEntries(people.map((x) => [x.id, x.name]));
    const rx = await reactionCounts(c, rows.map((r) => r.id), u.id);
    return { can_publish: isCreator(u, 'comedian'), episodes: rows.map((e) => ({ id: e.id, ts: e.ts, number: e.number, title: e.title, description: e.description, media_url: e.media_url,
      hosts: e.host_ids.split(',').filter((id) => id && names[id]).map((id) => ({ id, name: names[id] })), laughs: e.laughs, comments: e.comments, reactions: rx[e.id]?.counts || {}, my_reaction: rx[e.id]?.mine || null })) };
  },
  async 'POST podcast/episode'(c) {
    const u = needActive(c);
    if (!isCreator(u, 'comedian')) fail('Publishing episodes is for approved Circle Laughs comedians.', 403);
    await guard(c, u, c.body.description);
    const title = await cleanText(c, u, c.body.title, 140); if (title.length < 4) fail('Add an episode title.');
    const media = clean(c.body.media_url, 400);
    if (!EMBED_HOSTS.test(media)) fail('Paste a YouTube, Spotify or SoundCloud link to the episode.');
    const hosts = [...new Set([u.id, ...String(c.body.co_host_ids || '').split(',').map((x) => x.trim()).filter(Boolean)])].slice(0, 5);
    for (const h of hosts.slice(1)) if (!(await c.db.first("SELECT 1 FROM users WHERE id = ? AND status = 'active' AND account_type <> 'host'", h))) fail('Unknown co-host id: ' + h);
    const number = Number(c.body.number) || ((await c.db.first('SELECT MAX(number) n FROM podcast_episodes')).n || 0) + 1;
    const ep = await c.db.insert('podcast_episodes', { ts: now(), number, title, description: await cleanText(c, u, c.body.description, 2000), media_url: media, host_ids: hosts.join(','), created_by: u.id, status: 'published', laughs: 0, comments: 0 });
    return { id: ep.id, number };
  },
  async 'POST podcast/remove'(c) {
    const u = needActive(c);
    const e = await c.db.first('SELECT * FROM podcast_episodes WHERE id = ?', c.body.id) || fail('Not found', 404);
    if (e.created_by !== u.id && !STAFF.includes(u.role)) fail('Not yours.', 403);
    await c.db.update('podcast_episodes', e.id, { status: 'removed' });
    return { ok: true };
  },
};
