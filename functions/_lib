// Shared helpers: responses, crypto, sessions, rate limiting
const enc = new TextEncoder();
export const json = (data, status = 200, headers = {}) =>
  new Response(JSON.stringify(data), { status, headers: { 'content-type': 'application/json', 'cache-control': 'no-store', ...headers } });

const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
const hex = (buf) => [...new Uint8Array(buf)].map((x) => x.toString(16).padStart(2, '0')).join('');

export const randHex = (n = 32) => hex(crypto.getRandomValues(new Uint8Array(n)));
export const sha256 = async (s) => hex(await crypto.subtle.digest('SHA-256', enc.encode(s)));

export async function hmac(secret, msg) {
  const k = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  return hex(await crypto.subtle.sign('HMAC', k, enc.encode(msg)));
}

// PBKDF2 (100k is the Workers maximum)
export async function hashPw(pw, salt = crypto.getRandomValues(new Uint8Array(16))) {
  const k = await crypto.subtle.importKey('raw', enc.encode(pw), 'PBKDF2', false, ['deriveBits']);
  const bits = await crypto.subtle.deriveBits({ name: 'PBKDF2', hash: 'SHA-256', salt, iterations: 100000 }, k, 256);
  return b64(salt) + '$' + b64(bits);
}
export async function verifyPw(pw, stored) {
  const salt = unb64(stored.split('$')[0]);
  return (await hashPw(pw, salt)) === stored;
}

const COOKIE = 'vc_session';
const DAY = 86400;

export async function createSession(env, userId) {
  const token = randHex(32);
  await env.DB.prepare('INSERT INTO sessions (token_hash,user_id,expires_at) VALUES (?,?,?)')
    .bind(await sha256(token), userId, Math.floor(Date.now() / 1000) + 14 * DAY).run();
  return `${COOKIE}=${token}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${14 * DAY}`;
}
export const clearCookie = () => `${COOKIE}=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0`;

export async function getUser(request, env) {
  const m = (request.headers.get('cookie') || '').match(/(?:^|;\s*)vc_session=([a-f0-9]+)/);
  if (!m) return null;
  const th = await sha256(m[1]);
  return env.DB.prepare(
    `SELECT u.id,u.email,u.mobile,u.display_name,u.role,u.status,u.cohort_tier,u.referral_code,u.mobile_verified
     FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>?`
  ).bind(th, Math.floor(Date.now() / 1000)).first();
}

// KV fixed-window rate limit; throws a Response on excess
export async function rateLimit(env, key, max, windowSec = 60) {
  const k = `rl:${key}`;
  const n = parseInt((await env.KV.get(k)) || '0', 10);
  if (n >= max) throw json({ error: 'Too many attempts. Please wait a minute.' }, 429);
  await env.KV.put(k, String(n + 1), { expirationTtl: Math.max(windowSec, 60) });
}

export async function audit(env, actor, action, target, detail) {
  await env.DB.prepare('INSERT INTO audit_log (id,actor_id,action,target,detail,created_at) VALUES (?,?,?,?,?,?)')
    .bind(crypto.randomUUID(), actor, action, target || null, detail ? String(detail).slice(0, 500) : null, Date.now()).run();
}

export async function turnstileOk(env, token, ip) {
  if (!env.TURNSTILE_SECRET) return true; // disabled until secret is set
  const r = await fetch('https://challenges.cloudflare.com/turnstile/v0/siteverify', {
    method: 'POST', body: new URLSearchParams({ secret: env.TURNSTILE_SECRET, response: token || '', remoteip: ip }),
  });
  return !!(await r.json()).success;
}

export async function sendSms(env, number, message) {
  if (!env.SEMAPHORE_KEY) { console.log(`[DEV SMS] ${number}: ${message}`); return; }
  await fetch('https://api.semaphore.co/api/v4/messages', {
    method: 'POST', body: new URLSearchParams({ apikey: env.SEMAPHORE_KEY, number, message }),
  });
}
