<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin — The Virtual Circle</title><link rel="stylesheet" href="/css/tokens.css"></head>
<body><div class="wrap"><nav class="nav"><a class="brand" href="/">✨ Admin · KYC review</a></nav>
<div id="list" class="grid"></div><div id="m" class="msg"></div></div>
<script type="module">
import {api,$,say} from '/js/app.js';
const list=$('#list'),m=$('#m');
async function load(){try{const {user}=await api('me');if(!user||!['admin','moderator'].includes(user.role))return say(m,'Staff only. Sign in at /join.html with a staff account.');
 const {items}=await api('admin/kyc');list.innerHTML=items.length?'':'<p class="muted">Nothing waiting. 🌙</p>';
 for(const k of items){const c=document.createElement('div');c.className='card';
  c.innerHTML=`<h3></h3><p class="muted"></p><div class="grid g3"><div><p class="muted">ID</p><img class="kyc" src="/api/admin/kyc/file?id=${k.id}&which=id"></div><div><p class="muted">Selfie</p><img class="kyc" src="/api/admin/kyc/file?id=${k.id}&which=selfie"></div></div>
  <label>Note (optional)</label><input class="note"><p><button class="btn ok">Approve</button> <button class="btn ghost no">Reject</button></p>`;
  c.querySelector('h3').textContent=k.display_name+' · '+k.cohort_tier;
  c.querySelector('p').textContent=k.email+' · '+k.id_type+(k.flags?' · ⚠ '+k.flags+' flag(s)':'');
  const act=ok=>async()=>{try{await api('admin/kyc/review',{method:'POST',body:{id:k.id,approve:ok,note:c.querySelector('.note').value}});c.remove()}catch(e){say(m,e.message)}};
  c.querySelector('.ok').onclick=act(true);c.querySelector('.no').onclick=act(false);list.append(c)}}catch(e){say(m,e.message)}}
load();
</script></body></html>
