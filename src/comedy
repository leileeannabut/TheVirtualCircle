// Circle Laughs 😂: the funny side of VA life.
//   Laugh Feed (structured meme formats rendered as cards, no image hosting), Circle Writers (approved writers),
//   Circle Laughs Podcast (approved comedians; episodes embedded from YouTube/Spotify/SoundCloud), story submissions.
import { fail, now, uid, pj, clean, rate, audit, cfgNum } from './lib.js';
import { screenText, OFF_PLATFORM } from './services.js';
import { need, needActive, STAFF } from './routes.js';
import { notify, rankName } from './social.js';

const REACTS = ['tawa', 'dead', 'relate', 'real'];
const ROLES = (u) => String(u.creator_roles || '').split(',').filter(Boolean);
const isCreator = (u, kind) => STAFF.includes(u.role) || ROLES(u).includes(kind);
const WEEK = 7 * 864e5;

// Each format is a small set of text fields; the browser draws them as a meme card.
const FORMATS = {
  story: { label: 'Funny story', fields: { text: 1500 } },
  dialog: { label: 'Client vs Me', fields: { lines: 'lines' } },
  expectation: { label: 'Expectation vs Reality', fields: { expectation: 300, reality: 300 } },
  nobody: { label: 'Nobody: …', fields: { who: 60, text: 300 } },
  pov: { label: 'POV', fields: { text: 300 } },
  starter: { label: 'Starter pack', fields: { title: 80, items: 'items' } },
  tracker: { label: 'Time tracker screenshot', fields: { activity: 'pct', timer: 12, caption: 200, punchline: 300 } },
};

// Hides phone numbers, emails and Telegram/WhatsApp links in every field. Penalties are applied once per submission (guard()).
async function cleanText(c, u, s, max) {
  return clean(s, max).replace(/\\n/g, '\n').replace(new RegExp(OFF_PLATFORM.source, 'gi'), '[hidden: keep it on-platform]');
}
async function guard(c, u, raw) { // one screen per submission: penalty for off-platform contact attempts
  if (u.muted_until > now()) fail('You are muted for 24 hours after a safety flag.', 403);
  return screenText(c, u, String(raw || '').slice(0, 5000));
}
async function cleanBody(c, u, format, raw) {
  const f = (Object.prototype.hasOwnProperty.call(FORMATS, format || '') && FORMATS[format]) || fail('Pick a format.');
  const b = raw && typeof raw === 'object' ? raw : {};
  const out = {};
  for (const [k, spec] of Object.entries(f.fields)) {
    if (spec === 'lines') {
      const lines = (Array.isArray(b.lines) ? b.lines : []).slice(0, 10).map((l) => ({ who: clean(l && l.who, 30) || 'Me', text: clean(l && l.text, 240) })).filter((l) => l.text);
      if (lines.length < 2) fail('Add at least two lines to the conversation.');
      for (const l of lines) { l.who = (await cleanText(c, u, l.who, 30)) || 'Me'; l.text = await cleanText(c, u, l.text, 240); }
      out.lines = lines;
    } else if (spec === 'items') {
      const items = (Array.isArray(b.items) ? b.items : []).map((x) => clean(x, 80)).filter(Boolean).slice(0, 9);
      if (items.length < 3) fail('A starter pack needs at least 3 items.');
      out.items = []; for (const x of items) out.items.push(await cleanText(c, u, x, 80));
    } else if (spec === 'pct') {
      out[k] = Math.max(0, Math.min(100, Math.round(Number(b[k]) || 0)));
    } else {
      out[k] = await cleanText(c, u, b[k], spec);
    }
  }
  const main = { story: 'text', expectation: 'reality', nobody: 'text', pov: 'text', starter: 'title', tracker: 'caption' }[format];
  if (main && (!out[main] || out[main].length < 2)) fail('Fill in the funny part first 😄');
  if (format === 'starter' && !out.title) fail('Give your starter pack a title.');
  return out;
}
const authorOf = (c, r, anonymous) => anonymous
  ? { id: null, name: 'Anonymous VA', rank_name: 'Member', anonymous: true }
  : { id: r.author_id, name: r.author_name, rank_name: rankName(c, r.author_rank, r.author_type, r.author_role), creator: ROLES({ creator_roles: r.author_roles }), host: r.author_type === 'host', ambassador: (r.author_ambassador_until || 0) > now() };
const AUTHOR = 'u.id AS author_id, u.name AS author_name, u.va_rank AS author_rank, u.account_type AS author_type, u.role AS author_role, u.creator_roles AS author_roles, u.ambassador_until AS author_ambassador_until';

async function reactionCounts(c, ids, userId) {
  if (!ids.length) return {};
  const marks = ids.map(() => '?').join(',');
  const rows = await c.db.all(`SELECT target_id, type, COUNT(*) n, SUM(user_id = ?) mine FROM comedy_reactions WHERE target_id IN (${marks}) GROUP BY target_id, type`, userId, ...ids);
  const out = {};
  for (const r of rows) { const o = (out[r.target_id] ||= { counts: {}, mine: null }); o.counts[r.type] = r.n; if (r.mine) o.mine = r.type; }
  return out;
}
const TARGETS = { post: ['comedy_posts', 'user_id'], article: ['comedy_articles', 'author_id'], episode: ['podcast_episodes', 'created_by'] };
async function findTarget(c, id) {
  for (const [kind, [table, owner]] of Object.entries(TARGETS)) {
    const where = kind === 'post' ? 'removed = 0' : "status = 'published'";
    const r = await c.db.first(`SELECT id, ${owner} AS owner FROM ${table} WHERE id = ? AND ${where}`, id);
    if (r) return { kind, table, owner: r.owner, id: r.id };
  }
  fail('Not found', 404);
}
const EMBED_HOSTS = /^https:\/\/(www\.)?(youtube\.com|youtu\.be|open\.spotify\.com|soundcloud\.com|on\.soundcloud\.com|podcasters\.spotify\.com|anchor\.fm)\//i;

export const COMEDY_ROUTES = {
  // ───────── Laugh Feed ─────────
