  status: u.status, region: u.region, hub: u.hub, skills: u.skills, bio: u.bio, rate: u.rate, sim_score: u.sim_score, badges: pj(u.badges, []),
  founder_slot: u.founder_slot, referral_code: u.referral_code, tin: u.tin, address: u.address, payout_account: u.payout_account,
  risk_points: u.risk_points, muted_until: u.muted_until, va_rank: u.va_rank || 0, pro: (u.pro_until || 0) > Date.now(), pro_until: u.pro_until || 0,
  years_experience: u.years_experience || 0, headline: u.headline || '',
