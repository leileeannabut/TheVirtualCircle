    const claimed = await c.db.run("UPDATE kyc SET status = ?, reviewer = ?, note = ?, reviewed_at = ? WHERE id = ? AND status = 'pending'", approve ? 'approved' : 'rejected', s.id, note, now(), k.id);
    if (!claimed.meta.changes) fail('Already reviewed.', 409);
    let slot = '';
    const rankNames = cfgJson(c, 'rank_names', {});
    if (approve && k.kind === 'upgrade') {
      const rank = Math.max(u.va_rank || 0, Math.min(STAFF.includes(s.role) && s.role === 'founder' ? 4 : 3, Number(c.body.rank) || (u.va_rank || 0) + 1));
      const exp = pj(k.experience, {});
