// ── ranks, privileges, Pro ──
export const isPro = (u) => !!u && (u.pro_until || 0) > now();
export function can(c, u, priv) {
  if (!u) return false;
  if (STAFF.includes(u.role)) return true;
  return (u.va_rank || 0) >= (cfgJson(c, 'rank_privileges', {})[priv] ?? 99);
}
function needPriv(c, priv, msg) {
  const u = needActive(c);
  if (!can(c, u, priv)) fail(msg || 'Your verification rank does not include this yet. Raise your rank from your dashboard.', 403);
  return u;
}
export async function notify(c, userId, type, text, link = '') {
  if (!userId || (c.user && userId === c.user.id)) return;
  await c.db.insert('notifications', { ts: now(), user_id: userId, type, text: clean(text, 240), link, read: 0 });
}
const authorSql = 'u.id AS author_id, u.name AS author_name, u.va_rank AS author_rank, u.account_type AS author_type, u.role AS author_role, u.supporter_until AS author_supporter_until, u.ambassador_until AS author_ambassador_until, u.pro_until AS author_pro_until, u.hub AS author_hub, u.headline AS author_headline';
const author = (r, c) => ({ id: r.author_id, name: r.author_name, rank: r.author_rank || 0, rank_name: rankName(c, r.author_rank, r.author_type, r.author_role), pro: (r.author_pro_until || 0) > now(), supporter: (r.author_supporter_until || 0) > now(), ambassador: (r.author_ambassador_until || 0) > now(), host: r.author_type === 'host', hub: r.author_hub, headline: r.author_headline });
// Label shown next to a name: staff → Circle Team, clients → Verified Client, VAs → their verification rank.
export const rankName = (c, r, type, role) => (role === 'host' || type === 'host') ? 'Circle Host · AI' : STAFF.includes(role) ? 'Circle Team' : type === 'client' ? ((r || 0) >= 1 ? 'Verified Client' : 'Client')
  : cfgJson(c, 'rank_names', {})[String(r || 0)] || 'Member';

// Who may DM whom: accepted connection, active BFF match, client unlock, job application, or the "dm_anyone" rank privilege.
export async function canDm(c, a, b) {
  const other = a === c.user.id ? b : a;
  const q = await c.db.first(`SELECT
    (SELECT 1 FROM connections WHERE status = 'accepted' AND ((a = ?1 AND b = ?2) OR (a = ?2 AND b = ?1))) con,
    (SELECT 1 FROM bff_matches WHERE status = 'active' AND ((a = ?1 AND b = ?2) OR (a = ?2 AND b = ?1))) bff,
    (SELECT 1 FROM matches_and_unlocks WHERE status = 'unlocked' AND ((client_id = ?1 AND va_id = ?2) OR (client_id = ?2 AND va_id = ?1))) unl,
    (SELECT 1 FROM job_applications ja JOIN jobs j ON j.id = ja.job_id WHERE (ja.user_id = ?1 AND j.posted_by = ?2) OR (ja.user_id = ?2 AND j.posted_by = ?1)) app,
    (SELECT 1 FROM users WHERE id = ?3 AND status = 'active') other_active,
    (SELECT 1 FROM users WHERE id = ?3 AND account_type = 'host') other_host`, a, b, other);
  if (q.other_host) return false; // Circle Hosts are AI and never take private conversations
  if (q.con || q.bff || q.unl || q.app) return true;
  return !!(q.other_active && can(c, c.user, 'dm_anyone'));
}

