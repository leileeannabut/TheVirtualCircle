<script type="module">
import { api, shell } from '/js/app.js';
await shell();
const c = await api('config').catch(() => null);
if (c) {
  n.textContent = c.newbie_remaining; s.textContent = c.seasoned_remaining; nc.textContent = c.newbie_cap; sc.textContent = c.seasoned_cap;
  if (c.countdown_ends_at) {
    const end = new Date(c.countdown_ends_at).getTime(); cd.classList.remove('hidden');
    const tick = () => { const d = end - Date.now(); if (d <= 0) { t.textContent = 'Closed'; return; }
      t.textContent = Math.floor(d / 864e5) + 'd ' + Math.floor(d % 864e5 / 36e5) + 'h'; };
    tick(); setInterval(tick, 6e4);
  }
}
</script>
